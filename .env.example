# Copy to .env and fill in. Never commit .env.

# Required. Password for /leads and /leads.csv
LEADS_PASSWORD=

# Folder for leads.jsonl. Must be on storage that survives restarts.
DATA_DIR=./data

# Insight Tracker. Leave blank until the endpoint exists; leads are still saved.
TRACKER_WEBHOOK_URL=
TRACKER_WEBHOOK_SECRET=

# Port to listen on
PORT=8093
